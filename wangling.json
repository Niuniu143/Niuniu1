  local layout = LinearLayout(activity)
  layout.setOrientation(LinearLayout.VERTICAL)
  layout.setPadding(60, 60, 60, 60)
  layout.setBackgroundColor(Color.parseColor("#FFFFFF"))
  layout.setLayoutParams(ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))

  local titleText = TextView(activity)
  titleText.setText("ʟɪᴄᴇɴꜱᴇ ᴠᴇʀɪꜰɪᴄᴀᴛɪᴏɴ ")
  titleText.setTextColor(Color.parseColor("#000000"))
  titleText.setTextSize(24)
  titleText.setGravity(1)

  local messageText = TextView(activity)
  messageText.setText("ᴘᴜᴛ ʏᴏᴜʀ ʟɪᴄᴇɴꜱᴇ ɢɪᴠᴇɴ ʙʏ ʀᴇꜱᴇʟʟᴇʀ/ᴏᴡɴᴇʀ:")
  messageText.setTextColor(Color.parseColor("#3333FF"))
  messageText.setTextSize(18)
  messageText.setGravity(1)

  local input = EditText(activity)
  input.setHint("ᴇɴᴛᴇʀ ᴛʜᴇ ʟɪᴄᴇɴꜱᴇ")
  input.setTextSize(16)
  input.setPadding(20, 20, 20, 20)
  input.setLayoutParams(ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))

  local buttonLayout = LinearLayout(activity)
  buttonLayout.setOrientation(LinearLayout.HORIZONTAL)
  buttonLayout.setPadding(0, 40, 0, 0)
  buttonLayout.setGravity(1)

  local okButton = TextView(activity)
  okButton.setText("ʟᴏɢɪɴ")
  okButton.setTextSize(15)
  okButton.setTextColor(Color.WHITE)
  okButton.setBackgroundColor(Color.parseColor("#000000"))
  okButton.setPadding(30, 20, 30, 20)
  okButton.setGravity(1)
  okButton.setOnClickListener(function()
    local user_key = tostring(input.getText())
    local valid, message = isValidKey(user_key)
    if valid then
      -- The message from isValidKey now includes the remaining time
      Toast.makeText(activity, message, Toast.LENGTH_SHORT).show()
      for _, key_data in ipairs(keys) do
        if user_key == key_data.key and not isExpired(key_data.expiration_date) then
          local remaining_time, _ = getRemainingTime(key_data.expiration_date)
          -- Updated toast to show remaining time.
          Toast.makeText(activity, "ʏᴏᴜʀ ʟɪᴄᴇɴꜱᴇ ᴇxᴘɪʀᴇꜱ ɪɴ " .. remaining_time, Toast.LENGTH_LONG).show()
          dialog.dismiss()
          -- Start the continuous timer on the main screen
          startContinuousTimer(key_data.expiration_date)
          return
        end
      end
     else
      Toast.makeText(activity, message, Toast.LENGTH_SHORT).show()
    end
  end)

  local checkChannelButton = TextView(activity)
  checkChannelButton.setText("ʙᴜʏ ʟɪᴄᴇɴꜱᴇ")
  checkChannelButton.setTextSize(15)
  checkChannelButton.setTextColor(Color.WHITE)
  checkChannelButton.setBackgroundColor(Color.parseColor("#000000"))
  checkChannelButton.setPadding(30, 20, 30, 20)
  checkChannelButton.setGravity(1)
  checkChannelButton.setOnClickListener(function()
    intent = Intent(Intent.ACTION_VIEW, Uri.parse("https://t.me/prettylittlebabygirl64"))
    activity.startActivity(intent)
  end)

  local exitButton = TextView(activity)
  exitButton.setText("ᴇxɪᴛ")
  exitButton.setTextSize(15)
  exitButton.setTextColor(Color.WHITE)
  exitButton.setBackgroundColor(Color.parseColor("#000000"))
  exitButton.setPadding(30, 20, 30, 20)
  exitButton.setGravity(1)
  exitButton.setOnClickListener(function()
    activity.finish()
  end)

  buttonLayout.addView(okButton)
  buttonLayout.addView(checkChannelButton)
  buttonLayout.addView(exitButton)

  layout.addView(titleText)
  layout.addView(messageText)
  layout.addView(input)
  layout.addView(buttonLayout)

  dialog.setContentView(layout)
  dialog.show()
end

showKeyDialog()

-- [NEW CODE: Continuous Timer Function]

-- Global variable to hold the timer thread
local expiration_timer_thread = nil

-- Function to start a continuous timer on a TextView
function startContinuousTimer(expiration_date_str)
  local expiration_ts = dateToTimestamp(expiration_date_str)
  if not expiration_ts then return end

  -- Stop any existing timer
  if expiration_timer_thread then
    expiration_timer_thread:stop()
  end

  -- IMPORTANT: This timer relies on the 'timerDisplay' TextView added to 'layout.aly'.
  if timerDisplay == nil then
    print("Warning: timerDisplay TextView not found. Timer will not be visible.")
    return
  end

  expiration_timer_thread = timer(1000, function(t) -- Updates every 1000ms (1 second)
    local remaining_time, status = getRemainingTime(expiration_date_str)

    activity.runOnUiThread(function()
      if status == "Expired" then
        t:stop()
        timerDisplay.setText("LICENSE EXPIRED")
        timerDisplay.setTextColor(0xFFFF0000) -- Red color for expired
        -- os.exit() -- Uncomment to exit when expired
        return
      end

      timerDisplay.setText("Expires in: " .. remaining_time)
      -- Optional: Change color based on urgency (e.g., less than 24 hours)
      -- if math.difftime(expiration_ts, os.time()) < 86400 then
      --   timerDisplay.setTextColor(0xFFFFC300) -- Yellow
      --  else
      --   timerDisplay.setTextColor(0xFFFFFFFF) -- White
      -- end
    end)
  end)
end
