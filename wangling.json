-- [NEW CODE: Utility functions for time-based expiration]

-- Helper function to convert 'YYYY-MM-DD HH:MM:SS' string to a Unix timestamp
function dateToTimestamp(date_str)
  local year, month, day, hour, minute, second = date_str:match("(%d+)-(%d+)-(%d+) (%d+):(%d+):(%d+)")
  if not (year and month and day and hour and minute and second) then
    -- Fallback/Error handling for old YYYY-MM-DD format, assuming midnight expiration
    year, month, day = date_str:match("(%d+)-(%d+)-(%d+)")
    if year then
      return os.time({year=tonumber(year), month=tonumber(month), day=tonumber(day), hour=0, min=0, sec=0})
    end
    return nil -- Cannot parse date
  end
  return os.time({year=tonumber(year), month=tonumber(month), day=tonumber(day), hour=tonumber(hour), min=tonumber(minute), sec=tonumber(second)})
end

-- Calculates and formats the remaining time into a readable string
function getRemainingTime(expiration_date_str)
  local expiration_ts = dateToTimestamp(expiration_date_str)
  if not expiration_ts then return "Error: Invalid Date", "Error" end

  local current_ts = os.time()
  local remaining_seconds = math.max(0, os.difftime(expiration_ts, current_ts))

  if remaining_seconds <= 0 then
    return nil, "Expired"
  end

  local days = math.floor(remaining_seconds / (60 * 60 * 24))
  remaining_seconds = remaining_seconds % (60 * 60 * 24)
  local hours = math.floor(remaining_seconds / (60 * 60))
  remaining_seconds = remaining_seconds % (60 * 60)
  local minutes = math.floor(remaining_seconds / 60)
  local seconds = math.floor(remaining_seconds % 60)

  local time_parts = {}
  if days > 0 then table.insert(time_parts, days .. " days") end
  if hours > 0 then table.insert(time_parts, hours .. " hours") end
  if minutes > 0 then table.insert(time_parts, minutes .. " mins") end
  table.insert(time_parts, seconds .. " secs")

  return table.concat(time_parts, ", "), "Active"
end

-- Checks if the license is expired (now time-based)
function isExpired(expiration_date_str)
  local expiration_ts = dateToTimestamp(expiration_date_str)
  if not expiration_ts then return true end -- Default to expired if date is unreadable
  local current_ts = os.time()
  return current_ts >= expiration_ts
end

-- Updated keys with time (assuming midnight expiration for previous dates)
local keys = {
  {key = "Axion", expiration_date = "2026-12-08 23:59:59"}, -- Updated format: YYYY-MM-DD HH:MM:SS
  {key = "Kaz2", expiration_date = "2025-11-23 00:00:00"},
  {key = "Kazzue2", expiration_date = "2025-11-23 00:00:00"},
}

function isValidKey(user_key)
  for _, key_data in ipairs(keys) do
    if user_key == key_data.key then
      if isExpired(key_data.expiration_date) then
        return false, "ᴛʜᴇ ʟɪᴄᴇɴꜱᴇ ʜᴀꜱ ᴇxᴘɪʀᴇᴅ ᴏɴ " .. formatExpirationDate(key_data.expiration_date)
       else
        local remaining_time, _ = getRemainingTime(key_data.expiration_date)
        return true, "ᴀᴄᴄᴇꜱꜱ ɢʀᴀɴᴛᴇᴅ! ʀᴇᴍᴀɪɴɪɴɢ ᴛɪᴍᴇ: " .. remaining_time
      end
    end
  end
  return false, "ɪɴᴠᴀʟɪᴅ ʟɪᴄᴇɴꜱᴇ ᴛʀʏ ᴀɢᴀɪɴ."
end

-- Formats the full expiration date and time
function formatExpirationDate(expiration_date_str)
  local year, month, day, hour, minute, second = expiration_date_str:match("(%d+)-(%d+)-(%d+) (%d+):(%d+):(%d+)")
  if not year then
    -- Fallback for YYYY-MM-DD format
    year, month, day = expiration_date_str:match("(%d+)-(%d+)-(%d+)")
    if year then
      hour, minute, second = "00", "00", "00"
     else
      return expiration_date_str -- Return unformatted if unparsable
    end
  end
  local month_names = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
  local formatted_time = string.format("%02d:%02d:%02d", tonumber(hour), tonumber(minute), tonumber(second))
  return month_names[tonumber(month)] .. " " .. day .. ", " .. year .. " at " .. formatted_time
end

function showKeyDialog()
  local dialog = Dialog(activity)
  dialog.requestWindowFeature(Window.FEATURE_NO_TITLE)
  dialog.setCancelable(false)
